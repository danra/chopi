	# The GitHub API relay public repos fragment: anonymous REST for any other repo -- public
	# repos are readable, private ones 404, writes 401. Followed by the deny path.

	# any other repo: anonymous REST
	#
	# Id-form /repositories/{id} URLs, used in Link headers and renamed-repo redirects,
	# ride this lane too: renamed-repo redirects for all repos, and Link headers only for
	# non-allowlisted repos (allowlisted ones rewrite them to keep pagination working).
	@api_pub path_regexp ^(/repos/[^/]+/[^/]+|/repositories/[0-9]+)(/.*)?$
	handle @api_pub {
		import apiproxy api.github.com {
			# an anonymous 401 means an authed-only operation (a write, above all); GitHub's
			# raw "Requires authentication" begs for an in-sandbox gh auth login, which cannot
			# help -- name the allowlist instead.
			@unauth status 401
			handle_response @unauth {
				header Content-Type application/json
				respond `{"message":"chopi: GitHub requires authentication for this operation; the relay authenticates only repos in chopi's config/github-allowlist"}` 401
			}
		}
	}

	# 404s pass through unconverted (no DENY_PKT_FETCH analog): GitHub 404s private and
	# nonexistent repos alike, but a 404 here is also every legitimate miss on a public repo
	# (an absent branch or issue number), so converting would mislabel real answers.

	# GraphQL (/graphql) names its repo in the POST body, not the URL, so it cannot be scoped to
	# the allowlist here; it and account-level endpoints (gists, keys, /user) fall through to deny.
	handle {
		header Content-Type application/json
		respond `{"message":"chopi GitHub relay: not an allowed API operation"}` 403
	}
}
# GitHub API site end
